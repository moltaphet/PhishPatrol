  "platform_findings": {
    "emit_transfer_to_eoa_is_skipped_on_studio_next": {
      "summary": "On Studio Next, gl.chain.Account(eoa).emit_transfer(value, on='finalized') reaches the finalized phase but the message is marked skipped (declaredBudget 0) and the value is returned to the emitting contract. The transaction succeeds and the contract's own debit is applied, but the recipient is not paid. gl.chain.Account(...).emit_transfer(on='accepted') fails with FINISHED_WITH_ERROR. The SDK's simulated fee allocation is messageType 1 and an allocation retyped to 0 is rejected on-chain (ExternalAllocationInvalid).",
      "affects": "any contract paying out via emit_transfer, not specific to PhishPatrol logic",
